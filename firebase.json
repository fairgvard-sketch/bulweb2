{
  "hosting": {
    "site": "bulweb2",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "extracted_text.txt",
      "D _ Light Modern.html",
      "node_modules/**",
      "storage.rules",
      "firestore.rules",
      "CLAUDE.md",
      "package.json",
      "package-lock.json",
      "serviceAccount.json",
      "**/serviceAccount*.json",
      "cloudinary.env",
      "*.env",
      "scripts/**",
      "admin/import.html",
      "admin/import-menu.html",
      "admin/config.yml"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
